# Nuxt session / Google OAuth
# Generate a long random value (at least 32 characters) for production.
NUXT_SESSION_PASSWORD=
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Production PostgreSQL container
POSTGRES_DB=astral_patch
POSTGRES_USER=astral_patch
POSTGRES_PASSWORD=

# Host-only ports. Nginx proxies the app port; the DB port is used by SSH tunnels only.
ASTRAL_APP_PORT=3001
ASTRAL_DB_HOST_PORT=5433

# Server path to the canonical patch repository. Its database/migrations directory
# is mounted read-only into the migration container.
ASTRAL_PATCH_REPO_DIR=../astral-party-korean-patch

# Shared PostgreSQL database. Schema changes are owned by
# astral-party-korean-patch/database/migrations.
# Production Docker example:
DATABASE_URL=postgresql://astral_patch:PASSWORD@postgres-db:5432/astral_patch
# Local development can instead point to Neon or an SSH-forwarded server port.

# Optional AI translation gateway
AI_API_KEY=
AI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
