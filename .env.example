# 1. 로컬 개발 환경 (.env)
# 데이터베이스
DATABASE_URL=postgresql://astral_patch:PASSWORD@127.0.0.1:55433/astral_patch

# Nuxt 세션 / Google OAuth
NUXT_SESSION_PASSWORD=
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# Android App Link 서명 인증서 SHA-256 지문
NUXT_ANDROID_CERTIFICATE_SHA256=

# SSH 터널
ASTRAL_SSH_HOST=
ASTRAL_SSH_USER=ubuntu
ASTRAL_SSH_KEY_PATH=
ASTRAL_SSH_PORT=22
ASTRAL_DEV_DB_LOCAL_PORT=55433
ASTRAL_DEV_DB_REMOTE_HOST=127.0.0.1
ASTRAL_DEV_DB_REMOTE_PORT=5433

# 선택: AI 번역 게이트웨이
AI_API_KEY=
AI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway

# 선택: 두 릴리즈 저장소 GitHub API 인증 (rate limit 완화)
# maynut02/astral-party-korean-patch, maynut02/astral-party-auto-patcher 조회 권한 필요
GITHUB_TOKEN=

# 선택: WebSocket 제한값 (미설정 시 아래 기본값 사용)
ASTRAL_WS_ALLOWED_ORIGINS=
ASTRAL_WS_MAX_CONNECTIONS=500
ASTRAL_WS_MAX_CONNECTIONS_PER_IP=20
ASTRAL_WS_MAX_CONNECTION_ATTEMPTS_PER_IP=30
ASTRAL_WS_CONNECTION_ATTEMPT_WINDOW_MS=60000
ASTRAL_WS_MAX_MESSAGES_PER_WINDOW=60
ASTRAL_WS_MESSAGE_WINDOW_MS=60000
ASTRAL_WS_MAX_MESSAGE_BYTES=16384
ASTRAL_WS_HEARTBEAT_INTERVAL_MS=30000
ASTRAL_WS_HEARTBEAT_TIMEOUT_MS=90000
ASTRAL_WS_MAX_BUFFERED_BYTES=262144


# 2. GitHub 저장소 Secrets
#
# 필수
# SERVER_HOST=<VM IP 또는 SSH 호스트>
# SERVER_USER=ubuntu
# SERVER_SSH_KEY=<배포용 SSH 개인키>
# SERVER_SSH_FINGERPRINT=<SHA256 호스트 지문>
# SERVER_WORK_DIR=/home/ubuntu/astral-patch-site
#
# 옵션
# SERVER_SSH_PORT=22
#
# SERVER_SSH_FINGERPRINT 예시 확인
# sudo ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub -E sha256 | awk '{print $2}'


# 3. 서버 운영 환경
#
# DATABASE_URL=postgresql://astral_patch:PASSWORD@postgres-db:5432/astral_patch
#
# NUXT_SESSION_PASSWORD=<32자 이상의 임의 값>
# NUXT_OAUTH_GOOGLE_CLIENT_ID=
# NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
# NUXT_ANDROID_CERTIFICATE_SHA256=<AA:BB:... 형식의 인증서 SHA-256 지문>
#
# POSTGRES_DB=astral_patch
# POSTGRES_USER=astral_patch
# POSTGRES_PASSWORD=<URL에 안전한 강력한 비밀번호>
#
# ASTRAL_APP_PORT=3001
# ASTRAL_DB_HOST_PORT=5433
# ASTRAL_BACKUP_DIR=/var/backups/astral-patch
#
# AI_API_KEY=
# AI_BASE_URL=
# 선택: 두 릴리즈 저장소 GitHub API 인증 (rate limit 완화)
# maynut02/astral-party-korean-patch, maynut02/astral-party-auto-patcher 조회 권한 필요
# GITHUB_TOKEN=
#
# WebSocket (선택, 미설정 시 기본값 사용)
# ASTRAL_WS_ALLOWED_ORIGINS=https://astral.maynutlab.com
# 파티 채팅: nginx처럼 X-Real-IP를 덮어쓰는 신뢰 프록시 뒤에서만 사용.
# Docker Compose는 루프백 포트 + nginx 구성이므로 기본 true, 직접 실행은 기본 false.
# ASTRAL_TRUST_PROXY=true
# ASTRAL_WS_MAX_CONNECTIONS=500
# ASTRAL_WS_MAX_CONNECTIONS_PER_IP=20
# ASTRAL_WS_MAX_CONNECTION_ATTEMPTS_PER_IP=30
# ASTRAL_WS_CONNECTION_ATTEMPT_WINDOW_MS=60000
# ASTRAL_WS_MAX_MESSAGES_PER_WINDOW=60
# ASTRAL_WS_MESSAGE_WINDOW_MS=60000
# ASTRAL_WS_MAX_MESSAGE_BYTES=16384
# ASTRAL_WS_HEARTBEAT_INTERVAL_MS=30000
# ASTRAL_WS_HEARTBEAT_TIMEOUT_MS=90000
# ASTRAL_WS_MAX_BUFFERED_BYTES=262144
#
# Cloudflare R2 계정 ID (DB 백업과 번역 팩 배포가 함께 사용)
# R2_ACCOUNT_ID=
#
# Cloudflare R2 번역 팩 배포 (관리자 페이지 > 번역 팩 배포)
# translation-pack/latest.json, translation-pack/packs/{number}.json.gz에 업로드
# R2_PACK_ACCESS_KEY_ID=
# R2_PACK_SECRET_ACCESS_KEY=
# R2_PACK_BUCKET_NAME=
#
# Cloudflare R2 PostgreSQL 백업
# R2_BACKUP_ACCESS_KEY_ID=
# R2_BACKUP_SECRET_ACCESS_KEY=
# R2_BACKUP_BUCKET_NAME=astral-db-backup
# R2_BACKUP_PREFIX=postgres
# R2_BACKUP_ENDPOINT=
#
# systemd 백업 설정은 .env가 아니라 /etc/default/astral-patch에 등록.
# ASTRAL_APP_DIR=/home/ubuntu/astral-patch-site
# ASTRAL_COMPOSE_PROJECT=astral-patch
# ASTRAL_BACKUP_DIR=/var/backups/astral-patch
# ASTRAL_BACKUP_RETENTION_DAYS=14
# ASTRAL_R2_BACKUP_ENABLED=false
