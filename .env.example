# 1. 로컬 개발 환경 (.env)
# DB
DATABASE_URL=postgresql://astral_patch:PASSWORD@127.0.0.1:55433/astral_patch

# Nuxt session / Google OAuth
NUXT_SESSION_PASSWORD=
NUXT_OAUTH_GOOGLE_CLIENT_ID=
NUXT_OAUTH_GOOGLE_CLIENT_SECRET=

# SSH tunnel
ASTRAL_SSH_HOST=
ASTRAL_SSH_USER=ubuntu
ASTRAL_SSH_KEY_PATH=
ASTRAL_SSH_PORT=22
ASTRAL_DEV_DB_LOCAL_PORT=55433
ASTRAL_DEV_DB_REMOTE_HOST=127.0.0.1
ASTRAL_DEV_DB_REMOTE_PORT=5433

# Optional AI translation gateway
AI_API_KEY=
AI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway


# 2. GitHub Repository secrets
#
# 필수
# SERVER_HOST=<VM public IP or SSH hostname>
# SERVER_USER=ubuntu
# SERVER_SSH_KEY=<deployment SSH private key>
# SERVER_SSH_FINGERPRINT=<SHA256 host fingerprint>
# SERVER_WORK_DIR=/home/ubuntu/astral-patch-site
# PATCH_SERVER_WORK_DIR=/home/ubuntu/astral-party-korean-patch
#
# 옵션
# SERVER_SSH_PORT=22
#
# SERVER_SSH_FINGERPRINT 예시 확인
# sudo ssh-keygen -lf /etc/ssh/ssh_host_ed25519_key.pub -E sha256 | awk '{print $2}'


# 3. 서버 운영 환경
#
# DATABASE_URL=postgresql://astral_patch:PASSWORD@postgres-db:5432/astral_patch
#
# NUXT_SESSION_PASSWORD=<long random value, at least 32 characters>
# NUXT_OAUTH_GOOGLE_CLIENT_ID=
# NUXT_OAUTH_GOOGLE_CLIENT_SECRET=
#
# POSTGRES_DB=astral_patch
# POSTGRES_USER=astral_patch
# POSTGRES_PASSWORD=<URL-safe strong password>
#
# ASTRAL_APP_PORT=3001
# ASTRAL_DB_HOST_PORT=5433
# ASTRAL_PATCH_REPO_DIR=/home/ubuntu/astral-party-korean-patch
# ASTRAL_BACKUP_DIR=/var/backups/astral-patch
#
# AI_API_KEY=
# AI_BASE_URL=
#
# Cloudflare R2 PostgreSQL 백업
# R2_BACKUP_ACCOUNT_ID=
# R2_BACKUP_ACCESS_KEY_ID=
# R2_BACKUP_SECRET_ACCESS_KEY=
# R2_BACKUP_BUCKET_NAME=astral-patch-db-backups
# R2_BACKUP_PREFIX=postgres
# R2_BACKUP_ENDPOINT=
#
# systemd backup 설정은 .env가 아니라 /etc/default/astral-patch 에 등록.
# ASTRAL_APP_DIR=/home/ubuntu/astral-patch-site
# ASTRAL_COMPOSE_PROJECT=astral-patch
# ASTRAL_BACKUP_DIR=/var/backups/astral-patch
# ASTRAL_BACKUP_RETENTION_DAYS=14
# ASTRAL_R2_BACKUP_ENABLED=false
