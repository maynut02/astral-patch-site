{
  "name": "astral-patch-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "node --env-file=.env scripts/dev-with-tunnel.mjs",
    "dev:nuxt": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:check": "node scripts/check-migrations.mjs",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test:party": "node scripts/test-party-chat.mjs",
    "test:party:rooms": "node --experimental-strip-types scripts/test-party-rooms.mjs",
    "test:party:route": "node --experimental-strip-types scripts/test-party-route.mjs",
    "test:party:client": "node --experimental-strip-types scripts/test-party-reconnect-client.mjs",
    "test:party:adapter": "node scripts/test-party-ws-adapter.mjs",
    "test:party:storage": "node scripts/test-party-storage.mjs",
    "test:security": "node scripts/test-security-forge.mjs && node scripts/test-security-braces.mjs",
    "test:translation-pack": "node scripts/test-translation-pack.mjs && node scripts/test-translation-pack-realtime.mjs",
    "test:mods": "node scripts/test-mod-github.mjs && node scripts/test-mod-hub.mjs && node --experimental-strip-types scripts/test-mod-markdown.mjs && node scripts/test-mod-commits.mjs && node scripts/test-mod-management.mjs",
    "test:glossary": "node scripts/test-glossary.mjs",
    "test:unit": "pnpm run test:security && pnpm run test:mods && pnpm run test:translation-pack && pnpm run test:glossary && pnpm run test:party:rooms && pnpm run test:party:route && pnpm run test:party:client && pnpm run test:party:adapter",
    "audit:prod": "node scripts/audit-prod-deps.mjs",
    "lint:fix": "eslint . --fix",
    "check": "pnpm run db:check && pnpm run test:unit && pnpm run lint && pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.126",
    "@iconify-json/tabler": "^1.2.38",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/ui": "^4.11.1",
    "@takumi-rs/core": "^2.13.2",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "0.5.30",
    "nuxt-og-image": "^6.7.8",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.9.0",
    "nuxtseo-layer-devtools": "^5.3.14",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11",
    "ws": "8.21.3"
  },
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  }
}
